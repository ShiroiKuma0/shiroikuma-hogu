<?xml version="1.0" encoding="utf-8"?>
<!-- 白い熊 防具 UI page section header (the kxkb settings look): a thin full-width spacer above the
     group (hidden on the first section), then a big bold accent heading with a TEXT-WIDE accent
     underline. The underline must never span the page — it hugs the heading's own width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <!-- Thin full-width separator between this group and the previous one (1px = thinnest possible). -->
    <View
        android:id="@+id/hogu_section_spacer"
        android:layout_width="match_parent"
        android:layout_height="1px" />

    <LinearLayout
        android:id="@+id/hogu_section_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/hogu_section_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/hogu_section_rule"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
